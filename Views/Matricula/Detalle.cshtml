@model EduNova.DTOS.MatriculaDetalleDto
@{ ViewData["Title"] = "Detalle de matrícula"; }
<p class="mt-4"><a asp-controller="Credito" asp-action="Estado" asp-route-id="@Model.EstudianteId">Ver deuda total, beneficios y solvencia del estudiante</a></p><h1 class="mt-4">Matrícula #@Model.Resumen.Id</h1><p>@Model.Resumen.Estudiante · Registro: @Model.Resumen.Fecha.ToString("dd/MM/yyyy")</p>
@if (TempData["Exito"] is string exito) { <div class="alert alert-success" role="status">@exito</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="academia-grid"><article class="academia-card"><h2 class="h6">Total C$</h2><strong class="h3">@Model.Resumen.Total.ToString("N2")</strong></article><article class="academia-card"><h2 class="h6">Abonado C$</h2><strong class="h3">@Model.Resumen.Pagado.ToString("N2")</strong></article><article class="academia-card"><h2 class="h6">Saldo C$</h2><strong class="h3">@Model.Resumen.Saldo.ToString("N2")</strong></article></div>
<section class="academia-card mb-4"><h2 class="h4">Cursos inscritos</h2><ul>@foreach(var c in Model.Cursos) { <li>@c.Nombre — C$ @c.Costo.ToString("N2")</li> }</ul></section>
@if (User.HasPermission("pago.crear") && Model.Resumen.Saldo > 0) {
<section class="academia-card mb-4"><h2 class="h4">Registrar abono</h2><form asp-action="Pagar" method="post"><input name="MatriculaId" type="hidden" value="@Model.Resumen.Id"/><input name="OperacionId" type="hidden" value="@Model.NuevoPago.OperacionId"/>
<label for="Monto" class="form-label">Monto C$</label><input id="Monto" name="Monto" type="number" min="0.01" max="@Model.Resumen.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" required class="form-control mb-3"/>
<label for="Referencia" class="form-label">Referencia o nota opcional</label><input id="Referencia" name="Referencia" maxlength="100" class="form-control mb-3"/><button type="submit" class="btn btn-primary">Guardar abono</button></form></section> }
<section class="academia-card mb-4"><h2 class="h4">Calendario de cuotas</h2><p>Los abonos extra se aplican a las cuotas más antiguas de esta matrícula. No es necesario esperar al vencimiento.</p><div class="table-responsive"><table class="table"><thead><tr><th>Curso</th><th>Cuota</th><th>Vencimiento</th><th>Monto C$</th><th>Pagado C$</th><th>Saldo C$</th></tr></thead><tbody>@foreach(var c in Model.Cuotas) { <tr><td>@c.Curso</td><td>@c.Numero</td><td>@c.Vencimiento.ToString("dd/MM/yyyy")</td><td>@c.Monto.ToString("N2")</td><td>@c.Pagado.ToString("N2")</td><td>@c.Saldo.ToString("N2")</td></tr> }</tbody></table></div></section>
<section class="academia-card mb-4"><h2 class="h4">Historial de abonos</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Monto C$</th><th>Referencia</th><th>Recibo</th></tr></thead><tbody>@foreach(var pago in Model.Pagos) { <tr><td>@pago.Fecha.ToString("dd/MM/yyyy")</td><td>@pago.Monto.ToString("N2")</td><td>@pago.Referencia</td><td>@if (pago.ReciboId.HasValue) { <a asp-controller="Documentos" asp-action="Recibo" asp-route-id="@pago.ReciboId">Ver recibo</a> }</td></tr> }@if(Model.Pagos.Count == 0) { <tr><td colspan="3">Sin abonos registrados.</td></tr> }</tbody></table></div></section><a asp-action="Index" class="btn btn-outline-primary mb-4">Volver a matrículas</a>
