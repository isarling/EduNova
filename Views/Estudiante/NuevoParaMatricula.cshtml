@model EduNova.DTOS.SaveEstudianteDto

@{
    ViewData["Title"] = "Registrar estudiante";
}

<h1 class="mt-4">Registrar nuevo estudiante</h1>

<p>
    Registra sus datos y después continúa con la selección
    de cursos y el pago inicial.
</p>

<form asp-controller="Estudiante"
      asp-action="NuevoParaMatricula"
      method="post"
      class="academia-card">

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert">
    </div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre"
               class="form-control"
               maxlength="150"
               autocomplete="given-name"
               required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellido" class="form-label">Apellido</label>
        <input asp-for="Apellido"
               class="form-control"
               maxlength="150"
               autocomplete="family-name"
               required />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            Correo electrónico
        </label>
        <input asp-for="Email"
               type="email"
               class="form-control"
               autocomplete="email"
               required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <p class="text-muted">
        Esto registra al estudiante. Su matrícula se confirma
        en el siguiente paso. No se crea una cuenta de acceso.
    </p>

    <button type="submit" class="btn btn-primary">
        Guardar y continuar con la matrícula
    </button>

    <a asp-controller="Matricula"
       asp-action="Crear"
       class="btn btn-outline-secondary">
        Cancelar
    </a>
</form>