@model EduNova.DTOS.EstadoEstudianteDto
@{ ViewData["Title"] = "Estado de cuenta"; var propio = ViewData["EsAlumno"] is true; }
<h1 class="mt-4">@(propio ? "Mis cursos y pagos" : "Estado de cuenta")</h1><p>@Model.Nombre</p><partial name="_Mensajes" />
<div class="academia-grid"><article class="academia-card"><h2 class="h6">Deuda total C$</h2><strong class="h3">@Model.Deuda.ToString("N2")</strong></article><article class="academia-card"><h2 class="h6">Cursos activos</h2><strong class="h3">@Model.CursosActivos</strong></article><article class="academia-card"><h2 class="h6">Situación</h2><p>@Model.Observacion</p></article></div>
@if (!propio && User.HasPermission("solvencia.emitir") && Model.Deuda == 0 && Model.Matriculas.Count > 0) { <form asp-action="Solvencia" asp-controller="Credito" method="post" class="mb-4"><input type="hidden" name="estudianteId" value="@Model.EstudianteId"/><button class="btn btn-primary">Emitir constancia de solvencia</button></form> }
<section class="academia-card mb-4"><h2 class="h4">Matrículas</h2><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Total C$</th><th>Abonado C$</th><th>Saldo C$</th><th>Acción</th></tr></thead><tbody>@foreach(var m in Model.Matriculas) { <tr><td>@m.Id</td><td>@m.Total.ToString("N2")</td><td>@m.Pagado.ToString("N2")</td><td>@m.Saldo.ToString("N2")</td><td>@if (!propio && User.HasPermission("matricula.ver")) { <a asp-controller="Matricula" asp-action="Detalle" asp-route-id="@m.Id">Ver detalle</a> }</td></tr> }</tbody></table></div></section>
<section class="academia-card mb-4"><h2 class="h4">Cursos y calendario de cuotas</h2><div class="table-responsive"><table class="table"><thead><tr><th>Matrícula</th><th>Curso</th><th>Cuota</th><th>Vencimiento</th><th>Monto C$</th><th>Pagado C$</th><th>Pendiente C$</th></tr></thead><tbody>@foreach(var c in Model.Cuotas) { <tr><td>@c.MatriculaId</td><td>@c.Curso</td><td>@c.Numero</td><td>@c.Vencimiento.ToString("dd/MM/yyyy")</td><td>@c.Monto.ToString("N2")</td><td>@c.Pagado.ToString("N2")</td><td>@c.Saldo.ToString("N2")</td></tr> }</tbody></table></div><p>Los abonos pueden realizarse antes de cada vencimiento. El personal de caja verifica y registra los pagos.</p></section>
<section class="academia-card mb-4"><h2 class="h4">Beneficios por pago anticipado</h2>@if (Model.Beneficios.Count == 0) { <p>Sin beneficios emitidos.</p> }@foreach(var b in Model.Beneficios) { <p>Descuento @b.Porcentaje.ToString("N2") % · vence @b.Vence.ToString("dd/MM/yyyy") · @(b.Utilizado ? "Utilizado" : b.Vence.Date < EduNova.Services.ReglasCredito.Hoy ? "Vencido" : "Disponible")</p> }</section>
<section class="academia-card mb-4"><h2 class="h4">Recibos de pagos</h2>@foreach(var r in Model.Recibos) { <p><a asp-controller="Documentos" asp-action="Recibo" asp-route-id="@r.Id">@r.Nombre</a></p> }</section>
<section class="academia-card mb-4"><h2 class="h4">Constancias de solvencia</h2>@foreach(var c in Model.Constancias) { <p><a asp-controller="Documentos" asp-action="Solvencia" asp-route-id="@c.Id">@c.Nombre</a></p> }<p>La constancia acredita el saldo cero en su fecha de emisión. Nuevas matrículas pueden generar otra deuda.</p></section>
@if (!propio) { <a asp-controller="Matricula" asp-action="Index" class="btn btn-outline-primary mb-4">Volver a matrículas</a> }
