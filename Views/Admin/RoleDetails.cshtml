@model EduNova.DTOS.RoleWithPermissionDto

@{
    ViewData["Title"] = $"Rol: {Model.Name}";
    var allPermissions = ViewBag.AllPermissions as IReadOnlyList<EduNova.DTOS.PermissionDto>
        ?? Array.Empty<EduNova.DTOS.PermissionDto>();
    var assignedIds = Model.Permissions.Select(p => p.Id).ToHashSet();
    var assigned = Model.Permissions.ToList();
    var available = allPermissions.Where(p => !assignedIds.Contains(p.Id)).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Rol: @Model.Name</h1>
        <p class="text-muted mb-0">Asigna o quita permisos a este rol.</p>
    </div>
    <a asp-action="Roles" class="btn btn-outline-secondary btn-sm">
        Volver a roles
    </a>
</div>

<div id="permissionMessage" class="alert d-none" role="alert"></div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card admin-card mb-3">
            <div class="card-header bg-white fw-semibold">
                <i class="fa-solid fa-plus me-1 text-success"></i>
                Agregar permiso al rol
            </div>
            <div class="card-body">
                @if (available.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No hay permisos disponibles para asignar.
                    </p>
                }
                else
                {
                    <div class="mb-3">
                        <label for="permissionToAssign" class="form-label">
                            Permiso disponible
                        </label>
                        <select id="permissionToAssign" class="form-select">
                            @foreach (var permission in available)
                            {
                                <option value="@permission.Id">
                                    @permission.Name - @permission.Description
                                </option>
                            }
                        </select>
                    </div>
                    <button type="button"
                            id="btnAssignPermission"
                            class="btn btn-success w-100"
                            data-role-id="@Model.Id">
                        <i class="fa-solid fa-plus me-1"></i>
                        Asignar al rol
                    </button>
                }
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Asignados</span>
                    <span class="badge bg-success">@assigned.Count</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Disponibles</span>
                    <span class="badge bg-secondary">@available.Count</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card admin-card mb-4">
            <div class="card-header bg-white fw-semibold">
                Permisos asignados (@assigned.Count)
            </div>

            @if (assigned.Count == 0)
            {
                <div class="card-body text-muted">
                    Este rol no tiene permisos asignados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Permiso</th>
                                <th>Descripción</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in assigned)
                            {
                                <tr>
                                    <td><code>@permission.Name</code></td>
                                    <td>@permission.Description</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-toggle-permission"
                                                data-action="remove"
                                                data-role-id="@Model.Id"
                                                data-permission-id="@permission.Id">
                                            <i class="fa-solid fa-minus me-1"></i>
                                            Quitar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (available.Count > 0)
        {
            <div class="card admin-card">
                <div class="card-header bg-white fw-semibold">
                    Permisos disponibles (@available.Count)
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Permiso</th>
                                <th>Descripción</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in available)
                            {
                                <tr>
                                    <td><code>@permission.Name</code></td>
                                    <td>@permission.Description</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-success btn-toggle-permission"
                                                data-action="assign"
                                                data-role-id="@Model.Id"
                                                data-permission-id="@permission.Id">
                                            <i class="fa-solid fa-plus me-1"></i>
                                            Asignar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const message = document.getElementById("permissionMessage");
            let busy = false;

            async function updatePermission(button, action, permissionId) {
                if (busy) return;

                if (action === "remove" &&
                    !window.confirm("¿Quieres quitar este permiso del rol?")) {
                    return;
                }

                busy = true;
                button.disabled = true;
                message.className = "alert d-none";

                try {
                    const url = action === "assign"
                        ? '@Url.Action("AsingnPermissionToRole", "Admin")'
                        : '@Url.Action("RemovePermissionFromRole", "Admin")';

                    const body = new URLSearchParams({
                        roleId: button.dataset.roleId,
                        permissionId: permissionId
                    });

                    const response = await fetch(url, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: body.toString()
                    });

                    const contentType = response.headers.get("content-type") || "";

                    if (!contentType.includes("application/json")) {
                        throw new Error("La sesión expiró o no tienes permiso. Inicia sesión nuevamente.");
                    }

                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || "No se pudo actualizar el permiso.");
                    }

                    window.location.reload();
                } catch (error) {
                    message.textContent = error.message;
                    message.className = "alert alert-danger";
                    message.scrollIntoView({ block: "center" });
                } finally {
                    busy = false;
                    button.disabled = false;
                }
            }

            document.getElementById("btnAssignPermission")
                ?.addEventListener("click", function () {
                    const select = document.getElementById("permissionToAssign");
                    if (select?.value) {
                        updatePermission(this, "assign", select.value);
                    }
                });

            document.querySelectorAll(".btn-toggle-permission")
                .forEach(button => {
                    button.addEventListener("click", function () {
                        updatePermission(
                            this,
                            this.dataset.action,
                            this.dataset.permissionId
                        );
                    });
                });
        })();
    </script>
}