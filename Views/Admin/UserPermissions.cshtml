@model EduNova.DTOS.UserPermissionDto

@{
    ViewData["Title"] = $"Permisos de {Model.UserName}";
    var allPermissions = ViewBag.AllPermissions as IReadOnlyList<EduNova.DTOS.PermissionDto> ?? [];
    var allRoles = ViewBag.AllRoles as IReadOnlyList<EduNova.DTOS.RoleWithPermissionDto> ?? [];
    var directByPermission = Model.DirectPermission.ToDictionary(p => p.PermissionId);
    var effectivePermissions = Model.EffectivePermission.ToHashSet();
    var canChangeRole = ViewBag.CanChangeRole as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.UserName</h1>
        <p class="text-muted mb-0">
            @Model.Email — Rol actual: <strong>@Model.RoleName</strong>
        </p>
    </div>
    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
        Volver a usuarios
    </a>
</div>

<div class="alert alert-info">
    Después de modificar los permisos, el usuario deberá actualizar
    su sesión o volver a iniciar sesión para aplicar los cambios.
</div>

<div class="row g-4 mb-4">
    @if (canChangeRole)
    {
        <div class="col-lg-6">
            <div class="card admin-card h-100">
                <div class="card-header bg-white fw-semibold">
                    Cambiar rol
                </div>
                <div class="card-body">
                    <label for="userRoleSelect" class="form-label">Rol</label>
                    <div class="input-group">
                        <select id="userRoleSelect" class="form-select">
                            @foreach (var role in allRoles)
                            {
                                if (role.Id == Model.RoleId)
                                {
                                    <option value="@role.Id" selected>@role.Name</option>
                                }
                                else
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            }
                        </select>
                        <button type="button"
                                id="btnUpdateRole"
                                class="btn btn-primary"
                                data-user-id="@Model.UserId">
                            Guardar rol
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="@(canChangeRole ? "col-lg-6" : "col-12")">
        <div class="card admin-card h-100">
            <div class="card-header bg-white fw-semibold">
                Permisos efectivos
            </div>
            <div class="card-body">
                @if (Model.EffectivePermission.Count == 0)
                {
                    <p class="text-muted mb-0">Sin permisos efectivos.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var permission in Model.EffectivePermission)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                @permission
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header bg-white fw-semibold">
        Permisos directos del usuario
    </div>
    <div class="card-body">
        <p class="text-muted">
            Conceder o denegar establece una excepción individual.
            Quitar elimina esa excepción y vuelve a aplicar los permisos del rol.
        </p>
        <div class="table-responsive">
            <table id="userPermissionsTable"
                   class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Permiso</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var permission in allPermissions)
                    {
                        directByPermission.TryGetValue(permission.Id, out var direct);

                        <tr>
                            <td><code>@permission.Name</code></td>
                            <td>@(permission.Description ?? "-")</td>
                            <td>
                                @if (direct == null)
                                {
                                    <span class="badge bg-light text-dark border">
                                        Sin excepción
                                    </span>
                                    <div class="small text-muted mt-1">
                                        @(effectivePermissions.Contains(permission.Name) ? "Permitido por el rol" : "No concedido por el rol")
                                    </div>
                                }
                                else if (direct.IsGranted)
                                {
                                    <span class="badge bg-success">Concedido</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Denegado</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button"
                                            class="btn btn-outline-success btn-user-grant"
                                            data-user-id="@Model.UserId"
                                            data-permission-id="@permission.Id">
                                        Conceder
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-user-deny"
                                            data-user-id="@Model.UserId"
                                            data-permission-id="@permission.Id">
                                        Denegar
                                    </button>
                                    @if (direct != null)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-user-remove"
                                                data-user-id="@Model.UserId"
                                                data-permission-id="@permission.Id">
                                            Quitar
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/user-permission.js" asp-append-version="true"></script>
}