@model EduNova.Models.ReciboPago
@{ ViewData["Title"] = "Recibo de pago"; }
<article class="academia-card documento mt-4"><p>EDUNOVA</p><h1>Recibo de pago REC-@Model.Id.ToString("D6")</h1><p>Fecha: @Model.Fecha.AddHours(-6).ToString("dd/MM/yyyy HH:mm") · Matrícula: @Model.Pago.MatriculaId</p><p>Recibido de: <strong>@Model.NombreEstudiante</strong></p><p>Monto recibido: <strong>C$ @Model.Monto.ToString("N2")</strong></p><p>Referencia: @Model.Pago.Referencia</p><div class="table-responsive"><table class="table"><thead><tr><th>Curso</th><th>Cuota</th><th>Vencimiento</th><th>Aplicado C$</th></tr></thead><tbody>@foreach(var d in Model.Detalles) { <tr><td>@d.Curso</td><td>@d.NumeroCuota</td><td>@d.Vencimiento.ToString("dd/MM/yyyy")</td><td>@d.Monto.ToString("N2")</td></tr> }</tbody></table></div><p>Saldo de la matrícula después de este pago: <strong>C$ @Model.SaldoPosterior.ToString("N2")</strong></p><p>Documento de control interno de pagos.</p></article>
<button type="button" onclick="window.print()" class="btn btn-primary my-4 no-print">Imprimir o guardar en PDF</button>

<div class="no-print mb-4">@if (User.HasPermission("matricula.ver")) { <a asp-controller="Credito" asp-action="Estado" asp-route-id="@Model.Pago.Matricula.EstudianteId" class="btn btn-outline-primary">Consultar saldo total y solvencia</a> } else { <a asp-controller="Alumno" asp-action="Index" class="btn btn-outline-primary">Volver a mis cursos y pagos</a> }</div>
