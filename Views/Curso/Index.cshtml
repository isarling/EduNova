@using EduNova.Extensions

@{
    ViewData["Title"] = "Cursos";
    var catalogos = ViewBag.Catalogos as EduNova.DTOS.CatalogosVistaDto ?? new EduNova.DTOS.CatalogosVistaDto();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Cursos</h1>
        <p class="text-muted mb-0">Catálogo y precios de los cursos de la academia</p>
    </div>
    @if (User.HasPermission("curso.crear"))
    {
        <button type="button" id="btnNuevoCurso" class="btn btn-success">
            Nuevo curso
        </button>
    }
</div>

<div id="cursoError" class="alert alert-danger d-none"></div>

<div class="card admin-card">
    <div class="card-body table-responsive">
        <table id="cursoTable"
               class="table table-striped table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio C$</th>
                    <th>Estudiantes inscritos</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="cursoModal" tabindex="-1"
     aria-labelledby="cursoModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="cursoForm">
                <div class="modal-header">
                    <h5 id="cursoModalTitle" class="modal-title">Curso</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cursoId" />

                    <div class="mb-3">
                        <label for="cursoNombre" class="form-label">Nombre</label>
                        <input id="cursoNombre" class="form-control"
                               required maxlength="150" />
                    </div>

                    <div class="mb-3"><label for="cursoDuracion" class="form-label">Duración del curso en días</label><input id="cursoDuracion" type="number" min="1" max="730" value="90" required class="form-control"/></div>
                    <div class="mb-3"><label for="cursoCategoria" class="form-label">Categoría</label><select id="cursoCategoria" class="form-select"><option value="">Sin categoría</option>@foreach(var c in catalogos.Categorias) { <option value="@c.Id">@c.Nombre</option> }</select></div>
                    <div class="mb-3"><label for="cursoModalidad" class="form-label">Modalidad</label><select id="cursoModalidad" class="form-select"><option value="">Sin modalidad</option>@foreach(var m in catalogos.Modalidades) { <option value="@m.Id">@m.Nombre</option> }</select></div>
                    <div class="mb-3">
                        <label for="cursoPrecio" class="form-label">Precio del curso C$</label>
                        <input id="cursoPrecio" type="number" min="0.01" max="99999999.99" step="0.01" required class="form-control" />
                        <div class="form-text">Este precio aparecerá automáticamente al matricular.</div>
                    </div>
                    <div class="mb-3">
                        <label for="cursoDescripcion" class="form-label">
                            Descripción
                        </label>
                        <textarea id="cursoDescripcion" class="form-control"
                                  rows="3" maxlength="250"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" id="btnGuardarCurso"
                            class="btn btn-primary">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        window.cursosConfig = {
            canUpdate: @User.HasPermission("curso.actualizar").ToString().ToLowerInvariant(),
            canDelete: @User.HasPermission("curso.borrar").ToString().ToLowerInvariant()
        };
    </script>
    <script src="~/js/cursos.js" asp-append-version="true"></script>
}